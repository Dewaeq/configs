#!/usr/bin/env python3
# One launcher for sway (Super+D): apps, websites and files in a single rofi list.
# The list is cached in ~/.cache/launcher/entries so it opens instantly; after every use
# it is rebuilt in the background (`launcher --refresh`, also run at login).
#   apps:  desktop applications, most used first (counts in ~/.cache/launcher/usage.json)
#   web:   Firefox history + bookmarks, ranked by Firefox's own frecency
#   files: files and folders in ~ (via fd)
# Enter opens the selection. Typed text that matches nothing opens as a URL or a web search,
# and a typed address that is the start of the selected site opens exactly as typed.
import os
import re
import subprocess
import sys

CACHE = os.path.expanduser("~/.cache/launcher")
ENTRIES = os.path.join(CACHE, "entries")  # one entry per line: action \x1e rofi line
USAGE = os.path.join(CACHE, "usage.json")
PLACES = "~/snap/firefox/common/.mozilla/firefox/*.default*/places.sqlite"
SEARCH = "https://duckduckgo.com/?q="  # Firefox's default search engine here
TOP_SITES = 500
SEARCH_HOSTS = ("duckduckgo.", "google.", "bing.")


def entry(action, text, icon):
    text = text.replace("\n", " ")
    return f"{action}\x1e{text}\0icon\x1f{icon}"


def load_usage():
    import json
    try:
        with open(USAGE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def apps():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio
    usage, found = load_usage(), []
    for app in Gio.AppInfo.get_all():
        if not app.should_show() or not app.get_filename():
            continue
        name, generic = app.get_display_name(), app.get_generic_name()
        text = f"{name}  ({generic})" if generic and generic != name else name
        icon = app.get_icon()
        action = "app\t" + app.get_filename()
        found.append((-usage.get(action, 0), name.lower(),
                      entry(action, text, icon.to_string() if icon else "application-x-executable")))
    return [e for *_, e in sorted(found)]


def web():
    import glob
    import sqlite3
    from urllib.parse import urlsplit
    dbs = glob.glob(os.path.expanduser(PLACES))
    if not dbs:
        return []
    # immutable: read-only and works while Firefox has the database open
    # (visits from the last few minutes may not be written to it yet)
    con = sqlite3.connect(f"file:{dbs[0]}?immutable=1", uri=True)
    rows = con.execute(f"""
        select p.url, coalesce(p.title, ''), exists(select 1 from moz_bookmarks b
                                                    where b.fk = p.id and b.type = 1)
        from moz_places p
        where p.url like 'http%' and (
            p.id in (select id from moz_places where frecency > 0
                     order by frecency desc limit {TOP_SITES})
            or p.id in (select fk from moz_bookmarks where type = 1))
        order by p.frecency desc""")
    out, seen = [], set()
    for url, title, bookmarked in rows:
        u = urlsplit(url)
        if re.search(r"(^|&)q=", u.query) and any(h in u.netloc for h in SEARCH_HOSTS):
            continue  # old search result pages are noise
        short = (u.netloc.removeprefix("www.") + u.path).rstrip("/")
        text = f"{title[:70]}  ·  {short[:60]}" if title and title != short else short[:60]
        if text not in seen:
            seen.add(text)
            out.append(entry("url\t" + url, text, "user-bookmarks" if bookmarked else "web-browser"))
    return out


def files():
    home = os.path.expanduser("~")
    skip = ["/snap", "node_modules", "venv", "site-packages", "__pycache__", "build", "dist"]
    found = subprocess.run(["fdfind", "--type", "f", "--type", "d", ".", home]
                           + [arg for d in skip for arg in ("--exclude", d)],
                           capture_output=True, text=True).stdout
    return [entry("file\t" + p, "~" + p[len(home):].rstrip("/"),  # fd ends folders with "/"
                  "folder" if p.endswith("/") else "text-x-generic")
            for p in found.splitlines()]


def refresh():
    os.makedirs(CACHE, exist_ok=True)
    tmp = f"{ENTRIES}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write("\n".join(apps() + web() + files()))
    os.replace(tmp, ENTRIES)  # atomic: a launcher opening now sees the old or new list, whole


def norm(url):
    return re.sub(r"^[a-z]+://(www\.)?", "", url.strip().lower()).rstrip("/")


def typed_url(text):
    # What to open for typed text: an address as-is (https:// added), otherwise a search
    if re.match(r"^[a-z]+://", text):
        return text
    if " " not in text and "." in text:
        return "https://" + text
    from urllib.parse import quote_plus
    return SEARCH + quote_plus(text)


def detached(*cmd):
    subprocess.Popen(cmd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run():
    if not os.path.exists(ENTRIES):
        refresh()
    rofi = subprocess.Popen(
        ["rofi", "-dmenu", "-i", "-p", "Go", "-show-icons", "-sort", "-sorting-method", "fzf",
         "-format", "i f", "-theme-str", "window { width: 800px; }"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    actions = []
    try:
        with open(ENTRIES) as f:
            for rec in f:
                action, line = rec.rstrip("\n").split("\x1e", 1)
                actions.append(action)
                rofi.stdin.write(line + "\n")
        rofi.stdin.close()
    except BrokenPipeError:
        pass  # picked something before the whole list was loaded
    code, out = rofi.wait(), rofi.stdout.read()
    if code != 0 or not out.strip():
        return  # cancelled
    index, typed = out.rstrip("\n").split(" ", 1)
    index, typed = int(index), typed.strip()
    if not 0 <= index < len(actions):  # nothing matched, or Ctrl+Enter
        detached("gio", "open", typed_url(typed))
    else:
        kind, target = actions[index].split("\t", 1)
        if kind == "url" and "." in typed and " " not in typed \
                and norm(target).startswith(norm(typed)) and norm(target) != norm(typed):
            target = typed_url(typed)  # typed github.com/x while github.com/x/settings was picked
        if kind != "app":
            detached("gio", "open", target)
        else:
            # gtk-launch, not `gio launch`: gio exits before a D-Bus-started app (Loupe,
            # Nautilus...) gets the message to open a window, so nothing appeared
            detached("gtk-launch", os.path.basename(target))
            import json
            usage = load_usage()
            usage[actions[index]] = usage.get(actions[index], 0) + 1
            with open(USAGE + ".tmp", "w") as f:
                json.dump(usage, f)
            os.replace(USAGE + ".tmp", USAGE)
    detached(sys.executable, os.path.abspath(__file__), "--refresh")  # fresh list for next time


refresh() if sys.argv[1:] == ["--refresh"] else run()
