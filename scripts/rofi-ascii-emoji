#!/usr/bin/env python3
# Rofi picker for the GNOME "ASCII Emoji" extension's list (asciimoji.com).
# Reads and updates the extension's own data file, so the list and the
# most-used order are shared with GNOME. The chosen emoji goes to the clipboard.
import json
import os
import subprocess

DATA = os.path.expanduser(
    "~/.local/share/gnome-shell/extensions/ascii-emoji@masood.masaeli/emojis.json"
)

with open(DATA, encoding="utf-8") as f:
    emojis = json.load(f)
emojis.sort(key=lambda e: -e["count"])  # most used first, like the extension


def line(e):
    # Extra keywords (e.g. "koala" for "bear") stay visible so they're searchable
    extra = [k.strip() for k in e["keyword"].split(",") if k.strip() not in ("", e["name"])]
    return f"{e['name']:<16}{e['emoji']}" + (f"   ({', '.join(extra)})" if extra else "")


pick = subprocess.run(
    ["rofi", "-dmenu", "-i", "-p", "Emoji", "-format", "i"],
    input="\n".join(map(line, emojis)), capture_output=True, text=True,
).stdout.strip()
if not pick:
    raise SystemExit  # cancelled

chosen = emojis[int(pick)]
subprocess.run(["wl-copy"], input=chosen["emoji"], text=True)

chosen["count"] += 1
emojis.sort(key=lambda e: -e["count"])
# Write via a temp file so a crash can't leave GNOME's extension with a broken file
tmp = DATA + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(emojis, f, ensure_ascii=False)
os.replace(tmp, DATA)
