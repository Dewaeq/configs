#!/usr/bin/env bash
# Bluetooth menu: pick a device to connect/disconnect it. That's it.
# Replaced nickclyde/rofi-bluetooth (0cca4d4) on 2026-11-05 for a simpler flow.
# ponytail: no pairing agent, so only "just works" devices (speakers, headsets, mice)
# pair from here; for PIN-entry devices use blueman-manager (right-click in waybar).

menu() { rofi -dmenu -i -format i -p "$1"; }   # prints the chosen line's index
note() { notify-send -a Bluetooth "$@"; }

if ! bluetoothctl show | grep -q "Powered: yes"; then
    [ "$(printf 'Turn Bluetooth on' | menu Bluetooth)" = 0 ] || exit
    rfkill unblock bluetooth; sleep 1; bluetoothctl power on >/dev/null
    exec "$0"
fi

mapfile -t macs < <(bluetoothctl devices Paired | cut -d' ' -f2)
lines=() names=()
for mac in "${macs[@]}"; do
    info=$(bluetoothctl info "$mac")
    name=$(sed -n 's/^\s*Alias: //p' <<<"$info"); names+=("$name")
    if grep -q "Connected: yes" <<<"$info"; then lines+=("󰂱  $name"); else lines+=("    $name"); fi
done
lines+=("+  Pair new device…" "󰂲  Turn Bluetooth off")

i=$(printf '%s\n' "${lines[@]}" | menu Bluetooth)
[ -n "$i" ] || exit
n=${#macs[@]}

if (( i < n )); then
    mac=${macs[i]} name=${names[i]}
    if bluetoothctl info "$mac" | grep -q "Connected: yes"; then
        bluetoothctl disconnect "$mac" >/dev/null && note "Disconnected $name"
    else
        note "Connecting $name…"
        out=$(timeout 15 bluetoothctl connect "$mac" 2>&1) || [ $? -ne 124 ] || out="Failed: no answer in 15 s (off or out of range?)"
        if grep -q "Connection successful" <<<"$out"; then
            note "Connected $name"
        elif grep -q "key-missing" <<<"$out"; then
            note -u critical "$name forgot this laptop" "Put it in pairing mode, then choose 'Pair new device…' and pick it."
        else
            note -u critical "Could not connect $name" "$(grep -m1 -i fail <<<"$out")"
        fi
    fi
elif (( i == n )); then
    note "Scanning for 8 s…" "Put the device in pairing mode."
    bluetoothctl --timeout 8 scan on >/dev/null
    # Named, not-connected devices; already-paired ones stay listed so a lost pairing can be redone.
    fmacs=() fnames=()
    while read -r _ mac name; do
        [[ $name == "${mac//:/-}" ]] && continue   # unnamed device
        bluetoothctl info "$mac" | grep -q "Connected: yes" && continue
        fmacs+=("$mac") fnames+=("$name")
    done < <(bluetoothctl devices)
    [ ${#fmacs[@]} -gt 0 ] || { note "No devices found"; exit; }
    j=$(printf '%s\n' "${fnames[@]}" | menu Pair)
    [ -n "$j" ] || exit
    mac=${fmacs[j]} name=${fnames[j]}
    bluetoothctl remove "$mac" >/dev/null 2>&1   # drop any stale key first
    bluetoothctl --timeout 8 scan on >/dev/null  # removal forgets it; rediscover
    if timeout 30 bluetoothctl pair "$mac" | grep -q "Pairing successful"; then
        bluetoothctl trust "$mac" >/dev/null
        timeout 15 bluetoothctl connect "$mac" | grep -q "Connection successful" \
            && note "Paired and connected $name" || note -u critical "Paired $name, but connecting failed"
    else
        note -u critical "Pairing $name failed" "Is it in pairing mode? PIN devices: use blueman-manager."
    fi
else
    bluetoothctl power off >/dev/null
fi
